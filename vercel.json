{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gateway.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app-config",
      "destination": "/api/gateway?__path=/app-config"
    },
    {
      "source": "/oauth/(token|userinfo)",
      "destination": "/api/gateway?__path=/oauth/$1"
    },
    {
      "source": "/api",
      "destination": "/api/gateway?__path=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/gateway?__path=/api/$1"
    },
    {
      "source": "/((?!api(?:/|$)|app-config(?:/|$)|oauth/(?:token|userinfo)(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
